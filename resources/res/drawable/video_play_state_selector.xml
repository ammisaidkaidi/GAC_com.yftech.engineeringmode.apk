<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="false"
        android:state_pressed="true">
        <bitmap
            android:src="@mipmap/imgvideo_icon_play_nor"
            android:alpha="0.6"/>
    </item>
    <item
        android:state_selected="false"
        android:drawable="@mipmap/imgvideo_icon_play_nor"/>
    <item
        android:state_selected="true"
        android:state_pressed="true">
        <bitmap
            android:src="@mipmap/imgvideo_icon_pause_nor"
            android:alpha="0.6"/>
    </item>
    <item
        android:state_selected="true"
        android:drawable="@mipmap/imgvideo_icon_pause_nor"/>
</selector>
