<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2d2e33"
                android:endColor="#585b61"
                android:angle="90"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0b0c0e"
                android:endColor="#15181d"
                android:angle="90"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
