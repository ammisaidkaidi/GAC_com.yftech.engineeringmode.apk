<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="40dp">
        <TextView
            android:textSize="@dimen/main_title_txt"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:background="@drawable/shape_title_bg"
            android:layout_width="260dp"
            android:layout_height="60dp"
            android:text="@string/engineering_mode"
            android:layout_alignParentBottom="true"/>
        <TextView
            android:textSize="@dimen/main_title_txt"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_cur_view"
            android:background="@drawable/shape_title_bg"
            android:visibility="gone"
            android:layout_width="260dp"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/tv_title"/>
        <Button
            android:textSize="@dimen/main_title_txt"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_authentication"
            android:background="@drawable/title_btn_bg_selector"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:text="@string/internal_settings"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/tv_screenshot"/>
        <Button
            android:textSize="@dimen/main_exit_btn_txt"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_adb"
            android:background="@drawable/title_btn_bg_selector"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:text="adb"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/tv_screenshot"/>
        <Button
            android:textSize="@dimen/main_exit_btn_txt"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_screenshot"
            android:background="@drawable/title_btn_bg_selector"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:text="@string/screenshot"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/tv_back"/>
        <Button
            android:textSize="@dimen/main_exit_btn_txt"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_back"
            android:background="@drawable/title_btn_bg_selector"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:text="@string/back"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/tv_close"/>
        <Button
            android:textSize="@dimen/main_exit_btn_txt"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_close"
            android:background="@drawable/title_btn_bg_selector"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:text="@string/exit"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/line_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_width"/>
    <FrameLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.v7.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/fl_container"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
