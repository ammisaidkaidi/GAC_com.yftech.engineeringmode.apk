<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/upgrade_dialog_width"
    android:layout_height="@dimen/upgrade_dialog_height">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@mipmap/bg_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/layout_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/divider_horizontal"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp">
            <TextView
                android:textSize="28sp"
                android:textStyle="normal"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tv_content"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_not_find_update_file"
                android:layout_centerInParent="true"
                android:lineSpacingExtra="4dp"/>
            <RelativeLayout
                android:id="@+id/layout_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="28sp"
                    android:textStyle="normal"
                    android:textColor="#ffffffff"
                    android:gravity="center"
                    android:id="@+id/tv_checkbox_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/upgrade_checkbox_title"/>
                <CheckBox
                    android:textSize="28sp"
                    android:textStyle="normal"
                    android:textColor="#ffffffff"
                    android:id="@+id/ck_mcu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:button="@drawable/selector_checkbox"
                    android:text="@string/upgrade_checkbox_mcu"
                    android:layout_below="@+id/tv_checkbox_title"
                    android:paddingStart="10dp"
                    android:layout_alignStart="@+id/ck_os"/>
                <CheckBox
                    android:textSize="28sp"
                    android:textStyle="normal"
                    android:textColor="#ffffffff"
                    android:id="@+id/ck_os"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:button="@drawable/selector_checkbox"
                    android:text="@string/upgrade_checkbox_os"
                    android:layout_below="@+id/ck_mcu"
                    android:paddingStart="10dp"/>
                <CheckBox
                    android:textSize="28sp"
                    android:textStyle="normal"
                    android:textColor="#ffffffff"
                    android:id="@+id/ck_screen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:button="@drawable/selector_checkbox"
                    android:text="@string/upgrade_checkbox_screen"
                    android:layout_below="@+id/ck_os"
                    android:paddingStart="10dp"/>
                <CheckBox
                    android:textSize="28sp"
                    android:textStyle="normal"
                    android:textColor="#ffffffff"
                    android:id="@+id/ck_screen_mcu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:button="@drawable/selector_checkbox"
                    android:text="@string/upgrade_checkbox_screen_mcu"
                    android:layout_below="@+id/ck_screen"
                    android:paddingStart="10dp"/>
            </RelativeLayout>
        </RelativeLayout>
        <View
            android:id="@+id/divider_horizontal"
            android:layout_above="@+id/layout_btn"
            android:layout_marginStart="@dimen/divider_height"
            android:layout_marginEnd="@dimen/divider_height"
            style="@style/divider_horizontal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_btn"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="24sp"
                android:textColor="@drawable/selector_dialog_button_text"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/selector_dialog_left_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/upgrade_dialog_btn_start_upgrade_text"
                android:layout_weight="1"/>
            <View
                android:id="@+id/divider_vertical"
                android:layout_marginBottom="@dimen/divider_height"
                style="@style/divider_vertical"/>
            <Button
                android:textSize="24sp"
                android:textColor="@drawable/selector_dialog_button_text"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/selector_dialog_right_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/upgrade_dialog_btn_cancel_text"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
