<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height">
        <TextView
            android:text="@string/atcmetazone"
            style="@style/item_title_style"/>
        <Spinner
            android:id="@+id/sp_option"
            android:layout_toStartOf="@+id/atcmetazone_read"
            android:layout_alignParentEnd="false"
            style="@style/spinner_style"/>
        <Button
            android:id="@+id/atcmetazone_read"
            android:text="@string/query"
            android:layout_centerVertical="true"
            android:layout_marginEnd="20dp"
            android:layout_toStartOf="@+id/atcmetazone_write"
            style="@style/common_button"/>
        <Button
            android:id="@+id/atcmetazone_write"
            android:text="@string/write_in"
            android:layout_centerVertical="true"
            android:layout_marginEnd="40dp"
            android:layout_alignParentEnd="true"
            style="@style/common_button"/>
        <View style="@style/horizontal_divider_style"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <TextView
                android:text="@string/indexes"
                style="@style/item_title_style"/>
            <TextView
                android:id="@+id/tv_index"
                style="@style/item_title_style"/>
        </LinearLayout>
        <View style="@style/horizontal_divider_style"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_height">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <TextView
                android:text="@string/the_value"
                style="@style/item_title_style"/>
            <TextView
                android:id="@+id/tv_value"
                style="@style/item_title_style"/>
        </LinearLayout>
        <View style="@style/horizontal_divider_style"/>
    </RelativeLayout>
</LinearLayout>
