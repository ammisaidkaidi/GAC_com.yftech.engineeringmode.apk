<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:id="@+id/tv_title_authentication_carplay"
                android:text="@string/authentication_carplay"
                style="@style/item_title_style"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/authentication_carplay_tip"
                android:layout_alignBottom="@+id/tv_title_authentication_carplay"
                android:layout_toEndOf="@+id/tv_title_authentication_carplay"/>
            <Switch
                android:gravity="center_vertical"
                android:id="@+id/authentication_carplay"
                android:paddingLeft="48dp"
                android:paddingRight="48dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:switchMinWidth="100dp"
                android:layout_alignParentEnd="true"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:id="@+id/tv_title_authentication_hicar"
                android:text="@string/authentication_hicar"
                style="@style/item_title_style"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/authentication_hicar_tip"
                android:layout_alignBottom="@+id/tv_title_authentication_hicar"
                android:layout_toEndOf="@+id/tv_title_authentication_hicar"/>
            <Switch
                android:gravity="center_vertical"
                android:id="@+id/authentication_hicar"
                android:paddingLeft="48dp"
                android:paddingRight="48dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:switchMinWidth="100dp"
                android:layout_alignParentEnd="true"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/authentication_layout_same_rate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/authentication_same_rate"
                style="@style/item_title_style"/>
            <Switch
                android:gravity="center_vertical"
                android:id="@+id/authentication_same_rate"
                android:paddingLeft="48dp"
                android:paddingRight="48dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:switchMinWidth="100dp"
                android:layout_alignParentEnd="true"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/authenticaton_project_code"
                style="@style/item_title_style"/>
            <Spinner
                android:id="@+id/sp_save_option"
                style="@style/spinner_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
