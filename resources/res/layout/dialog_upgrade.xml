<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@mipmap/bg_dialog"
        android:layout_width="@dimen/upgrade_dialog_width"
        android:layout_height="@dimen/upgrade_dialog_height"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">
            <TextView
                android:textSize="24sp"
                android:textColor="#ffffff"
                android:id="@+id/tvUpgradeTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="24sp"
                android:textColor="#ffffff"
                android:gravity="start"
                android:id="@+id/tvUpgradeProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:layout_alignParentEnd="true"/>
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/seek_bar_progress"
                android:layout_below="@+id/tvUpgradeTip"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="22sp"
                android:textColor="#b3ffffff"
                android:id="@+id/tvWarnTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/upgrading_warn"
                android:layout_below="@+id/progressBar"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/divider_horizontal"
            android:layout_above="@+id/btnConfirm"
            android:layout_marginStart="@dimen/divider_height"
            android:layout_marginEnd="@dimen/divider_height"
            style="@style/divider_horizontal"/>
        <Button
            android:textSize="24sp"
            android:textColor="@drawable/selector_dialog_button_text"
            android:gravity="center"
            android:id="@+id/btnConfirm"
            android:background="@drawable/selector_dialog_one_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:text="@string/sure"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
