<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@mipmap/bg_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <android.support.v7.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/divider_horizontal"/>
        <View
            android:id="@+id/divider_horizontal"
            android:layout_above="@+id/layout_btn"
            style="@style/divider_horizontal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_btn"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="24sp"
                android:textColor="@drawable/selector_dialog_button_text"
                android:gravity="center"
                android:id="@+id/btn_close"
                android:background="@drawable/selector_dialog_one_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/screen_upgrade_dialog_btn_cancel"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
