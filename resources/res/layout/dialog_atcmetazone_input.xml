<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@mipmap/bg_dialog"
    android:layout_width="480dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/layout_index"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="40dp">
            <TextView
                android:textSize="28sp"
                android:textStyle="normal"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tv_title_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/indexe"
                android:layout_centerVertical="true"/>
            <Spinner
                android:id="@+id/sp_index"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_alignTop="@+id/tv_title_index"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="0dp"
                android:layout_toEndOf="@+id/tv_title_index"
                android:layout_alignParentEnd="false"
                style="@style/spinner_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/layout_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp">
            <TextView
                android:textSize="28sp"
                android:textStyle="normal"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tv_title_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/input_value"
                android:layout_centerVertical="true"/>
            <EditText
                android:textSize="22sp"
                android:textColor="#ffffffff"
                android:textColorHint="@color/dialog_btn_text_d_color"
                android:gravity="center_vertical"
                android:id="@+id/editText_value"
                android:background="@drawable/edit_bg"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="@string/input_tip"
                android:singleLine="true"
                android:digits="0123456789ABCDEFabcdef"
                android:layout_alignTop="@+id/tv_title_value"
                android:layout_centerHorizontal="true"
                android:imeOptions="actionDone"
                android:paddingStart="10dp"
                android:layout_marginStart="20dp"
                android:layout_toEndOf="@+id/tv_title_value"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider_horizontal"
        style="@style/divider_horizontal"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_btn"
        android:layout_width="match_parent"
        android:layout_height="60dp">
        <Button
            android:textSize="24sp"
            android:textColor="@drawable/selector_dialog_button_text"
            android:gravity="center"
            android:id="@+id/btn_sure"
            android:background="@drawable/selector_dialog_left_btn_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/sure"
            android:layout_weight="1"/>
        <View
            android:id="@+id/divider_vertical"
            style="@style/divider_vertical"/>
        <Button
            android:textSize="24sp"
            android:textColor="@drawable/selector_dialog_button_text"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/selector_dialog_right_btn_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
