<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="240dp">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@mipmap/bg_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/layout_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/divider_horizontal"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp">
            <TextView
                android:textSize="28sp"
                android:textStyle="normal"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_write_hint_message"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/divider_horizontal"
            android:layout_above="@+id/layout_btn"
            style="@style/divider_horizontal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_btn"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="24sp"
                android:textColor="@drawable/selector_dialog_button_text"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/selector_dialog_left_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/sure"
                android:layout_weight="1"/>
            <View
                android:id="@+id/divider_vertical"
                style="@style/divider_vertical"/>
            <Button
                android:textSize="24sp"
                android:textColor="@drawable/selector_dialog_button_text"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/selector_dialog_right_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cancel"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
