<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="96dp">
    <TextView
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="180dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="40dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_toStartOf="@+id/tv_result"
        android:layout_toEndOf="@+id/tv_name">
        <TextView
            android:textSize="22sp"
            android:textColor="@android:color/white"
            android:id="@+id/tv_file_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_info_file_value"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@android:color/white"
            android:id="@+id/tv_device_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/check_info_device_value"/>
    </LinearLayout>
    <TextView
        android:textSize="40sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="40dp"
        android:layout_alignParentEnd="true"/>
    <View style="@style/horizontal_divider_style"/>
</RelativeLayout>
