<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:background="@mipmap/bg_dialog"
        android:layout_width="640dp"
        android:layout_height="340dp">
        <RelativeLayout
            android:id="@+id/layout_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/divider_horizontal"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp">
            <TextView
                android:textSize="28sp"
                android:textColor="@android:color/white"
                android:id="@+id/tv_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:id="@+id/tv_cur_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:id="@+id/tv_file_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_cur_version"/>
        </RelativeLayout>
        <View
            android:id="@+id/divider_horizontal"
            android:layout_above="@+id/layout_btn"
            style="@style/divider_horizontal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_btn"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="28sp"
                android:textColor="@drawable/selector_dialog_button_text"
                android:gravity="center"
                android:id="@+id/btn_sure"
                android:background="@drawable/selector_dialog_left_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/screen_upgrade_dialog_btn_sure"
                android:layout_weight="1"/>
            <View
                android:id="@+id/divider_vertical"
                style="@style/divider_vertical"/>
            <Button
                android:textSize="28sp"
                android:textColor="@drawable/selector_dialog_button_text"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/selector_dialog_right_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/screen_upgrade_dialog_btn_cancel"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
