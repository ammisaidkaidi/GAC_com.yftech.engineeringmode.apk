<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:id="@+id/tv_set_title"
                android:text="@string/panel_brightness_set_title"
                style="@style/item_title_style"/>
            <Button
                android:textSize="28sp"
                android:textColor="@android:color/white"
                android:id="@+id/btn_sub"
                android:background="@drawable/tab_btn_bg_selector"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_brightness_sub"
                android:layout_centerVertical="true"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:layout_marginStart="48dp"
                android:layout_toEndOf="@+id/tv_set_title"/>
            <com.yftech.engineeringmode.widget.SeekBarNumber
                android:id="@+id/seekBarNumber"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="4dp"
                android:max="100"
                android:progressDrawable="@drawable/seek_bar_progress"
                android:thumb="@drawable/seek_bar_thumb"
                android:thumbOffset="0dp"
                android:layout_alignTop="@+id/btn_sub"
                android:layout_alignBottom="@+id/btn_sub"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_toStartOf="@+id/btn_inc"
                android:layout_toEndOf="@+id/btn_sub"
                android:splitTrack="false"
                app:TextSize="14sp"/>
            <Button
                android:textSize="28sp"
                android:textColor="@android:color/white"
                android:id="@+id/btn_inc"
                android:background="@drawable/tab_btn_bg_selector"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_brightness_inc"
                android:layout_centerVertical="true"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:layout_marginEnd="48dp"
                android:layout_alignParentEnd="true"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/camera_type"
                style="@style/item_title_style"/>
            <Spinner
                android:id="@+id/sp_camera_type"
                style="@style/spinner_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/additional_screen_temperature_protection"
                style="@style/item_title_style"/>
            <Spinner
                android:id="@+id/sp_screen_temperature_protection"
                style="@style/spinner_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/additional_mcu_test_mode"
                style="@style/item_title_style"/>
            <Switch
                android:gravity="center_vertical"
                android:id="@+id/additional_mcu_test_mode"
                android:paddingLeft="48dp"
                android:paddingRight="48dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:switchMinWidth="100dp"
                android:layout_alignParentEnd="true"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/additional_vehicle_speed"
                style="@style/item_title_style"/>
            <TextView
                android:id="@+id/additional_vehicle_speed"
                style="@style/item_content_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/additional_steering_wheel_angle"
                style="@style/item_title_style"/>
            <TextView
                android:id="@+id/additional_steering_wheel_angle"
                style="@style/item_content_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/additional_mcu_bootloader_version"
                style="@style/item_title_style"/>
            <TextView
                android:id="@+id/additional_mcu_bootloader_version"
                style="@style/item_content_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/additional_sys_version"
                style="@style/item_title_style"/>
            <TextView
                android:id="@+id/additional_sys_version"
                style="@style/item_content_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/additional_screen_upgrade"
                style="@style/item_title_style"/>
            <Button
                android:id="@+id/additional_screen_upgrade_btn"
                android:background="@drawable/tab_btn_bg_selector"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/additional_screen_upgrade_btn"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                style="@style/item_content_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/additional_sys_reboot"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/additional_sys_reboot"
                style="@style/item_title_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
