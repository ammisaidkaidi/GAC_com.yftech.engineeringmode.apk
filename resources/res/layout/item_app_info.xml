<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="96dp">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <TextView
        android:textSize="26sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/iv_icon"
        android:layout_toEndOf="@+id/iv_icon"/>
    <TextView
        android:textSize="26sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_app_package"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/tv_app_name"
        android:layout_alignStart="@+id/tv_app_name"/>
    <TextView
        android:textSize="26sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_version_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/tv_app_name"
        android:layout_alignBottom="@+id/tv_app_name"
        android:layout_marginEnd="48dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="26sp"
        android:textColor="@android:color/white"
        android:id="@+id/tv_version_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/tv_app_package"
        android:layout_alignBottom="@+id/tv_app_package"
        android:layout_alignEnd="@+id/tv_version_code"/>
    <View
        android:background="#26ccddff"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
