<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/item_height_min">
            <TextView
                android:id="@+id/tv_screen_debugging_title"
                android:text="@string/screen_debugging_title"
                style="@style/item_title_style"/>
            <View
                android:id="@+id/view_line"
                android:background="@color/divider_color"
                android:layout_width="@dimen/divider_height"
                android:layout_height="0dp"
                android:layout_alignTop="@+id/layout_screen_debugging_item"
                android:layout_alignBottom="@+id/layout_screen_debugging_item"
                android:layout_marginStart="48dp"
                android:layout_toEndOf="@+id/tv_screen_debugging_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_screen_debugging_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/view_line">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/layout_screen_brightness_debugging"
                    android:layout_width="match_parent"
                    android:layout_height="72dp">
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@android:color/white"
                        android:layout_width="192dp"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_brightness_debugging"
                        android:paddingStart="24dp"/>
                    <com.yftech.engineeringmode.widget.SeekBarNumber
                        android:id="@+id/sb_screen_brightness_debugging"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="4dp"
                        android:max="100"
                        android:progressDrawable="@drawable/seek_bar_progress"
                        android:thumb="@drawable/seek_bar_thumb"
                        android:thumbOffset="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:layout_marginEnd="100dp"
                        android:splitTrack="false"/>
                </LinearLayout>
                <View style="@style/horizontal_divider_style"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/layout_screen_contrast_debugging"
                    android:layout_width="match_parent"
                    android:layout_height="72dp">
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@android:color/white"
                        android:layout_width="192dp"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_contrast_debugging"
                        android:paddingStart="24dp"/>
                    <com.yftech.engineeringmode.widget.SeekBarNumber
                        android:id="@+id/sb_screen_contrast_debugging"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="4dp"
                        android:max="100"
                        android:progressDrawable="@drawable/seek_bar_progress"
                        android:thumb="@drawable/seek_bar_thumb"
                        android:thumbOffset="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:layout_marginEnd="100dp"
                        android:splitTrack="false"/>
                </LinearLayout>
                <View style="@style/horizontal_divider_style"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/layout_screen_gamma_value_debugging"
                    android:layout_width="match_parent"
                    android:layout_height="72dp">
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@android:color/white"
                        android:layout_width="192dp"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_gamma_value_debugging"
                        android:paddingStart="24dp"/>
                    <com.yftech.engineeringmode.widget.SeekBarNumber
                        android:id="@+id/sb_screen_gamma_value_debugging"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="4dp"
                        android:max="100"
                        android:progressDrawable="@drawable/seek_bar_progress"
                        android:thumb="@drawable/seek_bar_thumb"
                        android:thumbOffset="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:layout_marginEnd="100dp"
                        android:splitTrack="false"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <View style="@style/horizontal_divider_style"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/item_height_min">
            <TextView
                android:id="@+id/tv_screen_display_detection_title"
                android:layout_marginTop="24dp"
                android:text="@string/screen_display_detection_title"
                android:layout_centerVertical="false"
                style="@style/item_title_style"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:layout_below="@+id/tv_screen_display_detection_title"
                android:layout_alignStart="@+id/tv_screen_display_detection_title">
                <Button
                    android:id="@+id/btn_screen_display_detection_manual"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:text="@string/screen_display_detection_manual"
                    style="@style/common_button"/>
                <Button
                    android:id="@+id/btn_screen_display_detection_white"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:text="@string/screen_display_detection_white"
                    android:layout_marginStart="12dp"
                    style="@style/common_button"/>
                <Button
                    android:id="@+id/btn_screen_display_detection_black"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:text="@string/screen_display_detection_black"
                    android:layout_marginStart="12dp"
                    style="@style/common_button"/>
                <Button
                    android:id="@+id/btn_screen_display_detection_black_to_white"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:text="@string/screen_display_detection_black_to_white"
                    android:layout_marginStart="12dp"
                    style="@style/common_button"/>
                <Button
                    android:id="@+id/btn_screen_display_detection_red"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:text="@string/screen_display_detection_red"
                    android:layout_marginStart="12dp"
                    style="@style/common_button"/>
                <Button
                    android:id="@+id/btn_screen_display_detection_green"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:text="@string/screen_display_detection_green"
                    android:layout_marginStart="12dp"
                    style="@style/common_button"/>
                <Button
                    android:id="@+id/btn_screen_display_detection_blue"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:text="@string/screen_display_detection_blue"
                    android:layout_marginStart="12dp"
                    style="@style/common_button"/>
                <Button
                    android:id="@+id/btn_screen_display_detection_cycle"
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    android:text="@string/screen_display_detection_cycle"
                    android:layout_marginStart="12dp"
                    style="@style/common_button"/>
            </LinearLayout>
        </RelativeLayout>
        <View style="@style/horizontal_divider_style"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/item_height_min">
            <TextView
                android:id="@+id/textView_tp_test"
                android:text="@string/screen_tp_detection_title"
                style="@style/item_title_style"/>
            <CheckBox
                android:textSize="24sp"
                android:textColor="#ffffffff"
                android:gravity="center_vertical"
                android:id="@+id/cb_screen_tp_detection"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/selector_checkbox"
                android:text="@string/screen_tp_detection_auto_set_brightness"
                android:layout_centerVertical="true"
                android:paddingStart="10dp"
                android:layout_marginStart="40dp"
                android:layout_toEndOf="@+id/textView_tp_test"/>
        </RelativeLayout>
        <View style="@style/horizontal_divider_style"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/item_height_min">
            <TextView
                android:id="@+id/textView_screen_upgrade"
                android:text="@string/screen_upgrade_title"
                style="@style/item_title_style"/>
        </RelativeLayout>
        <View style="@style/horizontal_divider_style"/>
    </LinearLayout>
</ScrollView>
