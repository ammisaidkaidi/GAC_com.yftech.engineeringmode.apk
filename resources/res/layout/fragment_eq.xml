<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="@dimen/band_text_size"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/text_freq"
                android:layout_marginStart="140dp"/>
            <TextView
                android:textSize="@dimen/band_text_size"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/text_gain"
                android:layout_marginStart="110dp"/>
            <Button
                android:id="@+id/btn_confirm"
                android:text="@string/sure"
                android:layout_marginStart="80dp"
                style="@style/common_button"/>
        </LinearLayout>
        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/eq_band0"
                    layout="@layout/item_eq_adjust"/>
                <include
                    android:id="@+id/eq_band1"
                    layout="@layout/item_eq_adjust"/>
                <include
                    android:id="@+id/eq_band2"
                    layout="@layout/item_eq_adjust"/>
                <include
                    android:id="@+id/eq_band3"
                    layout="@layout/item_eq_adjust"/>
                <include
                    android:id="@+id/eq_band4"
                    layout="@layout/item_eq_adjust"/>
                <include
                    android:id="@+id/eq_band5"
                    layout="@layout/item_eq_adjust"/>
                <include
                    android:id="@+id/eq_band6"
                    layout="@layout/item_eq_adjust"/>
                <include
                    android:id="@+id/eq_band7"
                    layout="@layout/item_eq_adjust"/>
                <include
                    android:id="@+id/eq_band8"
                    layout="@layout/item_eq_adjust"/>
                <include
                    android:id="@+id/eq_band9"
                    layout="@layout/item_eq_adjust"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
