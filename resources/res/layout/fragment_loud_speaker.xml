<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/item_height_min">
            <TextView
                android:id="@+id/tv_loudspeaker_volume_title"
                android:text="@string/loudspeaker_volume"
                style="@style/item_title_style"/>
            <View
                android:id="@+id/view_line"
                android:background="@color/divider_color"
                android:layout_width="@dimen/divider_height"
                android:layout_height="0dp"
                android:layout_alignTop="@+id/layout_volume_item"
                android:layout_alignBottom="@+id/layout_volume_item"
                android:layout_marginStart="48dp"
                android:layout_toEndOf="@+id/tv_loudspeaker_volume_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_volume_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/view_line">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/layout_loudspeaker_volume_media"
                    android:layout_width="match_parent"
                    android:layout_height="72dp">
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@android:color/white"
                        android:layout_width="192dp"
                        android:layout_height="wrap_content"
                        android:text="@string/loudspeaker_volume_media"
                        android:paddingStart="@dimen/loudspeaker_txt"/>
                    <com.yftech.engineeringmode.widget.SeekBarNumber
                        android:id="@+id/sb_loudspeaker_volume_media"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="4dp"
                        android:max="39"
                        android:progressDrawable="@drawable/seek_bar_progress"
                        android:thumb="@drawable/seek_bar_thumb"
                        android:thumbOffset="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:layout_marginEnd="100dp"
                        android:splitTrack="false"/>
                </LinearLayout>
                <View style="@style/horizontal_divider_style"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/layout_loudspeaker_volume_voice"
                    android:layout_width="match_parent"
                    android:layout_height="72dp">
                    <TextView
                        android:textSize="@dimen/loudspeaker_txt"
                        android:textColor="@android:color/white"
                        android:layout_width="192dp"
                        android:layout_height="wrap_content"
                        android:text="@string/loudspeaker_volume_voice"
                        android:paddingStart="24dp"/>
                    <com.yftech.engineeringmode.widget.SeekBarNumber
                        android:id="@+id/sb_loudspeaker_volume_voice"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="4dp"
                        android:max="39"
                        android:progressDrawable="@drawable/seek_bar_progress"
                        android:thumb="@drawable/seek_bar_thumb"
                        android:thumbOffset="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:layout_marginEnd="100dp"
                        android:splitTrack="false"/>
                </LinearLayout>
                <View style="@style/horizontal_divider_style"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/layout_loudspeaker_volume_call"
                    android:layout_width="match_parent"
                    android:layout_height="72dp">
                    <TextView
                        android:textSize="@dimen/loudspeaker_txt"
                        android:textColor="@android:color/white"
                        android:layout_width="192dp"
                        android:layout_height="wrap_content"
                        android:text="@string/loudspeaker_volume_call"
                        android:paddingStart="24dp"/>
                    <com.yftech.engineeringmode.widget.SeekBarNumber
                        android:id="@+id/sb_loudspeaker_volume_call"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="4dp"
                        android:max="39"
                        android:progressDrawable="@drawable/seek_bar_progress"
                        android:thumb="@drawable/seek_bar_thumb"
                        android:thumbOffset="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:layout_marginEnd="100dp"
                        android:splitTrack="false"/>
                </LinearLayout>
                <View style="@style/horizontal_divider_style"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/layout_loudspeaker_volume_navi"
                    android:layout_width="match_parent"
                    android:layout_height="72dp">
                    <TextView
                        android:textSize="@dimen/loudspeaker_txt"
                        android:textColor="@android:color/white"
                        android:layout_width="192dp"
                        android:layout_height="wrap_content"
                        android:text="@string/loudspeaker_volume_navi"
                        android:paddingStart="24dp"/>
                    <com.yftech.engineeringmode.widget.SeekBarNumber
                        android:id="@+id/sb_loudspeaker_volume_navi"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="4dp"
                        android:max="39"
                        android:progressDrawable="@drawable/seek_bar_progress"
                        android:thumb="@drawable/seek_bar_thumb"
                        android:thumbOffset="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:layout_marginEnd="100dp"
                        android:splitTrack="false"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <View style="@style/horizontal_divider_style"/>
        <TextView
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:text="@string/loudspeaker_tip"
            style="@style/item_content_style"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <Button
                android:id="@+id/loudspeaker_fl"
                android:layout_marginLeft="30dp"
                android:text="@string/loudspeaker_fl"
                android:layout_alignParentLeft="true"
                style="@style/common_button"/>
            <Button
                android:id="@+id/loudspeaker_fr"
                android:layout_marginLeft="100dp"
                android:text="@string/loudspeaker_fr"
                android:layout_toRightOf="@+id/loudspeaker_fl"
                style="@style/common_button"/>
            <Button
                android:id="@+id/loudspeaker_rl"
                android:layout_marginLeft="100dp"
                android:text="@string/loudspeaker_rl"
                android:layout_toRightOf="@+id/loudspeaker_fr"
                style="@style/common_button"/>
            <Button
                android:id="@+id/loudspeaker_rr"
                android:layout_marginLeft="100dp"
                android:text="@string/loudspeaker_rr"
                android:layout_toRightOf="@+id/loudspeaker_rl"
                style="@style/common_button"/>
            <Button
                android:id="@+id/loudspeaker_play"
                android:layout_marginLeft="100dp"
                android:text="@string/loudspeaker_play"
                android:layout_toRightOf="@+id/loudspeaker_rr"
                style="@style/common_button"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
