<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:id="@+id/tv_set_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/tuner"
            android:layout_marginStart="40dp"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="50sp"
            android:textColor="#ffffff"
            android:id="@+id/radio_Freq_text"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="FM 87.5"
            android:layout_marginEnd="450dp"
            android:layout_alignParentEnd="true"/>
        <TableLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="0dp"
            android:stretchColumns="0,1,2,3,4,5"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="-4dp"
            android:layout_alignParentEnd="true">
            <TableRow
                android:gravity="center_vertical"
                android:id="@+id/radio_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp">
                <Button
                    android:textSize="20sp"
                    android:gravity="center"
                    android:id="@+id/music_play_update"
                    android:background="#3a7989"
                    android:layout_width="130dp"
                    android:layout_height="80dp"
                    android:text="@string/tuner_pre"/>
                <Button
                    android:textSize="20sp"
                    android:gravity="center"
                    android:id="@+id/music_play_prev"
                    android:background="#3a7989"
                    android:layout_width="130dp"
                    android:layout_height="80dp"
                    android:text="@string/tuner_step_back"/>
                <Button
                    android:textSize="20sp"
                    android:gravity="center"
                    android:id="@+id/music_play_pause"
                    android:background="#3a7989"
                    android:layout_width="130dp"
                    android:layout_height="80dp"
                    android:text="@string/tuner_play"/>
                <Button
                    android:textSize="20sp"
                    android:gravity="center"
                    android:id="@+id/music_play_next"
                    android:background="#3a7989"
                    android:layout_width="130dp"
                    android:layout_height="80dp"
                    android:text="@string/tuner_step"/>
                <Button
                    android:textSize="20sp"
                    android:gravity="center"
                    android:id="@+id/music_play_collect"
                    android:background="#3a7989"
                    android:layout_width="130dp"
                    android:layout_height="80dp"
                    android:text="@string/tuner_next"/>
                <Button
                    android:textSize="20sp"
                    android:gravity="center"
                    android:id="@+id/music_play_update_collect"
                    android:background="#3a7989"
                    android:layout_width="130dp"
                    android:layout_height="80dp"
                    android:text="@string/tuner_scan_list"/>
            </TableRow>
        </TableLayout>
    </RelativeLayout>
</LinearLayout>
