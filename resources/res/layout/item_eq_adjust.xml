<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/band_layout_height">
        <TextView
            android:textSize="@dimen/band_text_size"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_eq_band_name"
            android:layout_width="@dimen/band_text_layout_width"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="@dimen/btn_text_size"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/band_freq_reduce"
            android:background="@drawable/tab_btn_bg_selector"
            android:visibility="visible"
            android:layout_width="@dimen/btn_layout_width"
            android:layout_height="match_parent"
            android:text="@string/text_reduce"/>
        <com.yftech.engineeringmode.widget.GainEditText
            android:textSize="@dimen/band_text_size"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/band_freq_edit"
            android:focusable="true"
            android:layout_width="@dimen/edit_layout_width"
            android:layout_height="match_parent"
            android:text="@string/default_value"
            android:inputType="number"
            android:imeOptions="actionDone"/>
        <Button
            android:textSize="@dimen/btn_text_size"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/band_freq_plus"
            android:background="@drawable/tab_btn_bg_selector"
            android:visibility="visible"
            android:layout_width="@dimen/btn_layout_width"
            android:layout_height="match_parent"
            android:text="@string/text_plus"/>
        <Button
            android:textSize="@dimen/btn_text_size"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/band_gain_reduce"
            android:background="@drawable/tab_btn_bg_selector"
            android:layout_width="@dimen/btn_layout_width"
            android:layout_height="match_parent"
            android:text="@string/text_reduce"
            android:layout_marginStart="20dp"/>
        <com.yftech.engineeringmode.widget.GainEditText
            android:textSize="@dimen/band_text_size"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/band_gain_edit"
            android:layout_width="@dimen/edit_layout_width"
            android:layout_height="match_parent"
            android:text="@string/default_value"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"/>
        <Button
            android:textSize="@dimen/btn_text_size"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/band_gain_plus"
            android:background="@drawable/tab_btn_bg_selector"
            android:layout_width="@dimen/btn_layout_width"
            android:layout_height="match_parent"
            android:text="@string/text_plus"/>
    </LinearLayout>
</LinearLayout>
