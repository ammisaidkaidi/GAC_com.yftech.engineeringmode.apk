<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:id="@+id/tv_set_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/streeling_wheel_key_check"
            android:layout_marginStart="40dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="278dp"
        android:layout_weight="1">
        <TableLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:stretchColumns="0,1,2">
            <TableRow>
                <Button
                    android:gravity="center"
                    android:id="@+id/mute"
                    android:background="@drawable/streeling_key_btn_selector"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:text="MUTE"/>
                <Button
                    android:gravity="center"
                    android:id="@+id/mode"
                    android:background="@drawable/streeling_key_btn_selector"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:text="MODE"/>
                <Button
                    android:gravity="center"
                    android:id="@+id/vr"
                    android:background="@drawable/streeling_key_btn_selector"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:text="VR"/>
            </TableRow>
            <TableRow>
                <Button
                    android:gravity="center"
                    android:id="@+id/vol_up"
                    android:background="@drawable/streeling_key_btn_selector"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:text="VOL+"/>
                <Button
                    android:gravity="center"
                    android:id="@+id/off_hook"
                    android:background="@drawable/streeling_key_btn_selector"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:text="OFF-HOOK"/>
                <Button
                    android:gravity="center"
                    android:id="@+id/ch_up"
                    android:background="@drawable/streeling_key_btn_selector"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:text="CH+"/>
            </TableRow>
            <TableRow>
                <Button
                    android:gravity="center"
                    android:id="@+id/vol_down"
                    android:background="@drawable/streeling_key_btn_selector"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:text="VOL-"/>
                <Button
                    android:gravity="center"
                    android:id="@+id/on_hook"
                    android:background="@drawable/streeling_key_btn_selector"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:text="ON-HOOK"/>
                <Button
                    android:gravity="center"
                    android:id="@+id/ch_down"
                    android:background="@drawable/streeling_key_btn_selector"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="5dp"
                    android:text="CH-"/>
            </TableRow>
        </TableLayout>
    </LinearLayout>
</LinearLayout>
