<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/background_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/log_save_option"
                style="@style/item_title_style"/>
            <Spinner
                android:id="@+id/sp_save_option"
                style="@style/spinner_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/log_spi_save"
                style="@style/item_title_style"/>
            <Spinner
                android:id="@+id/sp_spi_save"
                style="@style/spinner_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/log_level"
                style="@style/item_title_style"/>
            <Spinner
                android:id="@+id/sp_level"
                style="@style/spinner_style"/>
            <View
                android:background="@color/line_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/line_width"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/log_display_time"
                style="@style/item_title_style"/>
            <Spinner
                android:id="@+id/sp_display_time"
                style="@style/spinner_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/mRlTboxLog"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/log_tbox"
                style="@style/item_title_style"/>
            <TextView
                android:textSize="24sp"
                android:textColor="@android:color/white"
                android:id="@+id/tv_tbox_log_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="48dp"
                android:layout_toStartOf="@+id/btn_tbox_log"/>
            <Button
                android:id="@+id/btn_tbox_log"
                android:text="@string/log_tbox_download_button"
                android:layout_centerVertical="true"
                android:layout_marginEnd="48dp"
                android:layout_alignParentEnd="true"
                style="@style/common_button"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:id="@+id/tv_title_canlog"
                android:text="@string/log_canlog"
                style="@style/item_title_style"/>
            <Switch
                android:gravity="center_vertical"
                android:id="@+id/sw_canlog"
                android:paddingLeft="48dp"
                android:paddingRight="48dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:switchMinWidth="100dp"
                android:layout_alignParentEnd="true"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:id="@+id/tv_title_canlog_display"
                android:text="@string/log_canlog_display"
                style="@style/item_title_style"/>
            <Switch
                android:gravity="center_vertical"
                android:id="@+id/sw_canlog_display"
                android:paddingLeft="48dp"
                android:paddingRight="48dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:switchMinWidth="100dp"
                android:layout_alignParentEnd="true"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/log_remote_upload_settings"
                style="@style/item_title_style"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_height">
            <TextView
                android:text="@string/log_clean"
                style="@style/item_title_style"/>
            <Button
                android:id="@+id/btn_clean_log"
                android:text="@string/log_clean"
                android:layout_centerVertical="true"
                android:layout_marginEnd="48dp"
                android:layout_alignParentEnd="true"
                style="@style/common_button"/>
            <View style="@style/horizontal_divider_style"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
